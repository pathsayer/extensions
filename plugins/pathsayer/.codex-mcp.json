{
  "mcpServers": {
    "pathsayer": {
      "command": "node",
      "args": [
        "scripts/mcp-proxy.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "PATHSAYER_TOKEN",
        "PATHSAYER_TOKEN_FILE",
        "PATHSAYER_ORIGIN",
        "PATHSAYER_BASE",
        "PATHSAYER_HOOK_STATE",
        "PATHSAYER_HARNESS",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "NODE_EXTRA_CA_CERTS",
        "CODEX_INTERNAL_ORIGINATOR_OVERRIDE"
      ]
    }
  }
}
