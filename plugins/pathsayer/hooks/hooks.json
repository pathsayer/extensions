{
  "description": "Pathsayer recon \u2014 before you edit code, surface the prior authorship + reasoning for the exact region, as a PreToolUse briefing; after a git commit lands, deep recon on the commit (the diff is read here with git show and walked server-side \u2014 the model never carries it). Every event rides ONE bare command adapter (recon-hook.mjs) that reads the harness's own hook_event_name + tool_name from stdin and decides what to do \u2014 this file carries no behavior, so it changes only when an event is added or removed. Token-authenticated HTTP serve; fail-open \u2014 a missing bearer or slow server never blocks the turn. Arming: the hooks and the MCP proxy read the client token the signed-in Pathsayer tray writes for this machine, or PATHSAYER_TOKEN; with neither, the MINT hook (UserPromptSubmit) tells the user so in one line, once per machine \u2014 nothing is asked of the model. Capture: on a laptop, the tray's; in a cloud environment (Claude Code Cloud) the COURIER (ship.mjs, Stop + SessionEnd) ships the environment's transcripts to the client-token ingest door, for the repos enabled on that cloud device. A session that belongs to a constellation attempt (its start prompt's first line names the attempt) is the same courier grown: at every Stop it saves the work, ships, and asks Pathsayer for the next task — holding the stop up to the number the server hands it (540 s by default) inside the 590 s budget here; on the first prompt it does the handshake and applies a predecessor's package inside the 60 s budget. Outside an attempt both return at once. Unknown surfaces no-op.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/mint.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/statusline-install.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/recon-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/ship.mjs\"",
            "timeout": 590
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")/$(ls \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\" | sort -t. -k3,3n -k4,4n | tail -1)/scripts/ship.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
