{
  "description": "Pathsayer recon — before you edit code, surface the prior authorship + reasoning for the exact region, as a PreToolUse briefing; after a git commit lands, deep recon on the commit (the diff is read here with git show and walked server-side — the model never carries it). Every event rides ONE bare command adapter (recon-hook.mjs) that reads the harness's own hook_event_name + tool_name from stdin and decides what to do — this file carries no behavior, so it changes only when an event is added or removed. Token-authenticated HTTP serve; fail-open — a missing bearer or slow server never blocks the turn. Arming: the MINT hook (UserPromptSubmit) stages a ticket and directs the model to call mint_client_token once per machine per connector; the recon hooks redeem the ticket for the bearer out-of-band. No web toggle, no secret to paste: the connector grant + installed plugin are the opt-in. Capture belongs to the tray today. Unknown surfaces no-op.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/mint.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/statusline-install.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(ls -td \"$(dirname \"${CLAUDE_PLUGIN_ROOT}\")\"/*/ | head -1)scripts/recon-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
